{
  "name": "@floralink/core",
  "version": "2.0.1",
  "description": "Library for querying and statistically analyzing plant occurrence data in combination with taxon specific traits like Ellenberg indicator values or Red List classifications",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": {
    "name": "Vincent Ruge",
    "email": "info@schwince.de"
  },
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "clean": "biome check --write",
    "deps": "npm-check-updates --interactive --format group",
    "build": "rimraf dist && tsc --declaration"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "npm-check-updates": "^22.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  }
}
